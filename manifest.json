{
  "manifest_version": 3,
  "name": "K3ypissr NukeBar",
  "short_name": "NukeBar",
  "version": "3.0.0",
  "description": "K3ypissr NukeBar: the classic k3ypissr HackBar rebuilt for current browsers, merging HackBar v2.9 + Mod payloads with header replay, decoder, Admin Finder, Reverse IP and network viewer.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "activeTab",
    "cookies",
    "storage",
    "unlimitedStorage",
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "contextMenus",
    "scripting",
    "contentSettings",
    "proxy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "K3ypissr NukeBar",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/hackbar_icon.png",
      "48": "icons/icon48.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/hackbar_icon.png",
    "48": "icons/icon48.png",
    "128": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/shims.js",
        "content/generated/payloads.js",
        "content/engines/shared.js",
        "content/engines/pro.js",
        "content/engines/mod.js",
        "content/app.js",
        "content/panel.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/panel.css",
        "content/generated/payloads.json",
        "icons/*",
        "pages/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
